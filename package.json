  "repository": {
    "type": "git",
    "url": "https://github.com/TrueCrimeDev/Tableau-LSP"
  },
  "homepage": "https://github.com/TrueCrimeDev/Tableau-LSP#readme",
  "bugs": {
    "url": "https://github.com/TrueCrimeDev/Tableau-LSP/issues"
  },
  "keywords": [
    "tableau",
    "calculation",
    "language",
    "syntax",
    "highlighting",
