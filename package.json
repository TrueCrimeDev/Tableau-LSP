{
  "name": "tableau-language-support",
  "displayName": "Tableau Language Support",
  "description": "Tableau calculations, workbook XML editing, Copilot tools, formatting, and verified TWB/TWBX exports for Tableau Desktop",
  "version": "1.14.0",
  "publisher": "TrueCrimeAudit",
