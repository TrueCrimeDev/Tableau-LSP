        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.testLogging",
        "title": "Test Logging",
        "category": "Tableau"
      },
      {
        "command": "tableau-lsp.extractCalculationsPython",
        "title": "Extract Calculations",
        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.addSelectionToCalcBank",
        "title": "Add Selection to Calc Bank",
        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.removeUnusedCalculations",
        "title": "Remove Unused Calculations from Workbook",
        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.workbook.editXml",
        "title": "Edit Workbook XML",
        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.workbook.saveCopy",
        "title": "Save a Workbook Copy",
        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.workbook.saveCopyAndOpen",
        "title": "Save a Workbook Copy and Open in Tableau",
        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.workbook.previewChanges",
        "title": "Compare Workbook with Backup",
        "category": "Tableau"
      },
      {
        "command": "tableau-language-support.workbook.restoreBackup",
        "title": "Restore Workbook Backup",
        "category": "Tableau"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tableau-language-support.addSelectionToCalcBank",
          "when": "editorLangId == twbl && editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "tableau-language-support.workbook.editXml",
          "when": "resourceExtname == .twb || resourceExtname == .twbx",
          "group": "tableau@0"
        },
        {
          "command": "tableau-language-support.workbook.saveCopy",
          "when": "resourceExtname == .twb || resourceExtname == .twbx",
          "group": "tableau@1"
        },
        {
          "command": "tableau-language-support.workbook.saveCopyAndOpen",
          "when": "resourceExtname == .twb || resourceExtname == .twbx",
          "group": "tableau@2"
        },
        {
          "command": "tableau-language-support.workbook.previewChanges",
          "when": "resourceExtname == .twb || resourceExtname == .twbx",
          "group": "tableau@3"
        },
        {
          "command": "tableau-language-support.workbook.restoreBackup",
          "when": "resourceExtname == .twb || resourceExtname == .twbx",
          "group": "tableau@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tableau-language-support.validateExpression",
        "key": "ctrl+alt+t v",
        "when": "editorTextFocus && resourceExtname == .twbl"
      },
      {
        "command": "tableau-language-support.insertIfStatement",
        "key": "ctrl+alt+t i",
        "when": "editorTextFocus && resourceExtname == .twbl"
      },
      {
        "command": "tableau-language-support.insertCaseStatement",
        "key": "ctrl+alt+t c",
        "when": "editorTextFocus && resourceExtname == .twbl"
      },
      {
        "command": "tableau-language-support.insertLodExpression",
        "key": "ctrl+alt+t l",
        "when": "editorTextFocus && resourceExtname == .twbl"
      },
      {
        "command": "tableau-language-support.showFunctionHelp",
        "key": "ctrl+alt+t h",
        "when": "editorTextFocus && resourceExtname == .twbl"
      },
      {
        "command": "tableau-language-support.toggleComments",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && resourceExtname == .twbl"
      },
      {
        "command": "tableau-language-support.lsp.restart",
        "key": "ctrl+alt+t r",
        "when": "editorTextFocus && resourceExtname == .twbl"
      },
      {
        "command": "tableau-language-support.compileAndReload",
        "key": "alt+f13"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build-base -- --minify",
    "build-base": "node esbuild.mjs",
    "build": "npm run build-base -- --sourcemap",
    "watch": "npm run build-base -- --sourcemap --watch",
    "test": "npm run typecheck && npm run test:unit -- --runInBand && npm run test:deterministic && npm run test:workbook-host",
    "test:hover": "node ./test-runner.js",
    "test:hover:compile": "npm run build && npm run test:hover",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "compile": "tsc --outDir out",
    "clean": "rimraf out",
    "test:all": "npm run compile && npx jest --runInBand",
    "test:unit": "jest --roots src/tests/unit",
    "test:deterministic": "jest --runInBand --detectOpenHandles src/tests/integration/localTableauFeatures.deterministic.test.ts src/tests/unit/commonCalculations.test.ts src/tests/unit/workbookCalculations.test.ts src/tests/unit/workbookEditService.test.ts",
    "test:incremental": "npm run compile && npx jest --testPathPattern=incremental",
    "test:error": "npm run compile && npx jest --testPathPattern=errorRecovery",
    "test:performance": "npm run compile && npx jest --config=./src/tests/performance/jest.performance.config.js",
    "test:integration": "npm run compile && npx jest --config=./src/tests/integration/jest.integration.config.js",
    "test:performance:suite": "npm run compile && npx jest --config=./src/tests/performance/jest.performance.config.js",
    "test:performance:stress": "npm run compile && npx jest --config=./src/tests/performance/jest.performance.config.js --testPathPattern=stressTests",
    "test:performance:lsp": "npm run compile && npx jest --config=./src/tests/performance/jest.performance.config.js --testPathPattern=lspPerformance",
    "test:performance:baseline": "npm run test:performance -- --baseline ./test-results/performance/baseline.json",
    "test:edge": "npm run compile && npx jest --config=./src/tests/edge/jest.edge.config.js",
    "test:edge:suite": "npm run compile && npx jest --config=./src/tests/edge/jest.edge.config.js",
    "test:edge:malformed": "npm run compile && npx jest --config=./src/tests/edge/jest.edge.config.js --testPathPattern=malformedInputs",
    "test:edge:boundary": "npm run compile && npx jest --config=./src/tests/edge/jest.edge.config.js --testPathPattern=boundaryConditions",
    "test:edge:recovery": "npm run compile && npx jest --config=./src/tests/edge/jest.edge.config.js --testPathPattern=errorRecovery",
    "test:report": "open ./test-results/test-report.html",
    "package": "vsce package",
    "publish": "node scripts/publish-tested-vsix.cjs",
    "test:workbook-host": "npm run build && node scripts/run-workbook-host-tests.cjs",
    "test:vsix": "node scripts/run-vsix-smoke-tests.cjs",
    "test:release": "node --test scripts/release-tools.test.cjs",
    "release:manifest": "node scripts/create-release-artifact.cjs",
    "release:verify": "node scripts/verify-marketplace.cjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.8",
    "@types/vscode": "1.95.0",
    "@types/which": "^2.0.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.24.0",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "3.2.5",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.0.0",
    "vscode-uri": "^3.2.0"
  },
  "dependencies": {
    "camelcase": "^7.0.1",
    "fast-xml-parser": "^4.4.0",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.7.15",
    "lodash-es": "^4.17.21",
    "saxes": "^6.0.0",
    "semver": "^7.5.2",
    "vscode-languageclient": "10.0.0-next.15",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "which": "^3.0.0"
  }
